# Copy to .env and fill in. NEVER commit .env.
DB_OWNER_USER=staffowner
DB_OWNER_PASSWORD=            # owns the schema, runs migrations only
DB_APP_PASSWORD=              # password of the restricted role the API uses (no ' characters)
JWT_SECRET=                   # openssl rand -base64 48
BOOTSTRAP_ADMIN_EMAIL=admin@yourcollege.edu
BOOTSTRAP_ADMIN_PASSWORD=     # min 12 chars; used once to create the first super admin
CORS_ORIGIN=http://localhost:5173
